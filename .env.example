# Copy to .env (gitignored) or ~/.snapchat-ads-mcp/.env and fill in. Never commit real values.

# --- Required ---

# Snap OAuth app credentials (Snap Business Manager -> Business Details -> OAuth apps).
# The client secret is shown only once, when you create the app.
SNAPCHAT_ADS_CLIENT_ID=
SNAPCHAT_ADS_CLIENT_SECRET=

# --- Refresh token (set ONE of these, or neither if you use the default file) ---

# `snapchat-ads-mcp auth` saves the refresh token here
# (default ~/.snapchat-ads-mcp/secrets/snapchat-ads-token.json, owner-only permissions).
SNAPCHAT_ADS_TOKEN_FILE=
# Or put the refresh token itself here. Prefer the file.
SNAPCHAT_ADS_REFRESH_TOKEN=

# Redirect URI registered on the OAuth app, if not http://localhost:8765/callback.
SNAPCHAT_ADS_REDIRECT_URI=

# --- Optional ---

# Default ad account and organisation (snapchat_ads_list_organizations shows them).
SNAPCHAT_ADS_AD_ACCOUNT_ID=
SNAPCHAT_ADS_ORGANIZATION_ID=

# Folder media files may be uploaded from (snapchat_ads_upload_media). Unset = uploads off.
SNAPCHAT_ADS_UPLOAD_DIR=

# Start in dry-run: writes are logged and previewed but NOT sent to Snap.
SNAPCHAT_ADS_DRY_RUN=true

# Register only read-only tools (lists, stats, estimates).
SNAPCHAT_ADS_READ_ONLY=false

# Only register some tool groups, e.g. accounts,campaigns,ad_squads,reporting
SNAPCHAT_ADS_TOOL_GROUPS=

# Safety limits: writes beyond these need confirm='APPLY'.
SNAPCHAT_ADS_BULK_THRESHOLD=10
SNAPCHAT_ADS_MAX_INCREASE_PCT=20
# Optional caps in whole units of the ad account currency (blank = no cap).
SNAPCHAT_ADS_MAX_BUDGET=
SNAPCHAT_ADS_MAX_BID=

# Audit log of writes (default ~/.snapchat-ads-mcp/logs/audit.jsonl) and how many days
# to keep entries (0 = forever).
SNAPCHAT_ADS_AUDIT_LOG=
SNAPCHAT_ADS_AUDIT_RETENTION_DAYS=30

# Paging (50-1000), timeout (seconds), request rate (Snap allows ~10/s per token) and
# the largest async report the server will download (MB).
SNAPCHAT_ADS_PAGE_SIZE=500
SNAPCHAT_ADS_TIMEOUT=30
SNAPCHAT_ADS_MAX_RPS=8
SNAPCHAT_ADS_MAX_DOWNLOAD_MB=200

SNAPCHAT_ADS_LOG_LEVEL=INFO

# Transport: stdio (default) or streamable-http (served at /mcp, localhost only unless
# SNAPCHAT_ADS_ALLOW_REMOTE=true).
SNAPCHAT_ADS_TRANSPORT=stdio
SNAPCHAT_ADS_HOST=127.0.0.1
SNAPCHAT_ADS_PORT=8000
SNAPCHAT_ADS_ALLOW_REMOTE=false
